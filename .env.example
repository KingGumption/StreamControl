# Mode: local (everything on this PC), cloud (hosted web app), or connector (streaming PC bridge)
APP_MODE=local

# HTTP server and persistent data. Local mode defaults are shown here.
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
DATA_DIR=./data

# Required only in cloud mode. Generate SESSION_SECRET and BRIDGE_TOKEN as long random values.
ADMIN_PASSWORD=
SESSION_SECRET=
BRIDGE_TOKEN=

# Required only in connector mode, using the same BRIDGE_TOKEN as the cloud service.
CONNECTOR_CLOUD_URL=ws://127.0.0.1:8787/bridge

# Optional Polaroid overrides. Detailed settings live in data/polaroid-config.json.
POLAROID_OBS_PASSWORD=
POLAROID_CAMERA_SOURCE=
POLAROID_DISCORD_WEBHOOK=

# Spotify developer application and target playlist.
# Put real credentials only in .env, never in this template.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/callback
SPOTIFY_PLAYLIST_ID=
# Only add results Spotify marks as non-explicit.
SPOTIFY_CLEAN_ONLY=true
# Add accepted requests to the active Spotify device's playback queue.
SPOTIFY_QUEUE_ENABLED=true

# TikFinity's local WebSocket endpoint
TIKFINITY_WS_URL=ws://127.0.0.1:21213/

# Streamer.bot's local WebSocket server endpoint
STREAMERBOT_WS_URL=ws://127.0.0.1:8080/
STREAMERBOT_WS_PASSWORD=

# Optional Streamer.bot action ID that forwards a `message` argument to
# TikFinity's sendChatbotMessage integration.
STREAMERBOT_TIKTOK_REPLY_ACTION_ID=

# Command throttling, in seconds
USER_COOLDOWN_SECONDS=5
GLOBAL_COOLDOWN_SECONDS=1

# Feature/runtime switches
PLAYLIST_COMMAND_PUBLIC=true
DRY_RUN=false
