APP_MODE=cloud
BIND_HOST=0.0.0.0
PUBLIC_BASE_URL=https://your-streamengagement-host.example
DATA_DIR=/var/data

ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
BRIDGE_TOKEN=replace-with-at-least-32-random-characters

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://your-streamengagement-host.example/callback
SPOTIFY_PLAYLIST_ID=
SPOTIFY_CLEAN_ONLY=true
SPOTIFY_QUEUE_ENABLED=true

# Streamer.bot authentication and cloud-side command/reply configuration.
STREAMERBOT_WS_PASSWORD=
STREAMERBOT_TIKTOK_REPLY_ACTION_ID=

POLAROID_CAMERA_SOURCE=Camera
POLAROID_DISCORD_WEBHOOK=
POLAROID_TWITCH_CHAT_ENABLED=true
POLAROID_TWITCH_CHAT_ACTION_NAME=Post Polaroid Link
POLAROID_AVATAR_RESOLVER_ENABLED=true
POLAROID_AVATAR_RESOLVER_ACTION_NAME=Resolve Polaroid Avatar

USER_COOLDOWN_SECONDS=5
GLOBAL_COOLDOWN_SECONDS=1
PLAYLIST_COMMAND_PUBLIC=true
DRY_RUN=false
